    "requirements": {
      "path_template": "docs/requirements/{name}.md",
      "filename_pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "template": "catalog/templates/generic-requirements.md",
      "required_sections": [
        {
          "key": "purpose",
          "heading": "1. Purpose and scope",
          "required_fields": [
            "system_boundary"
          ]
        },
        {
          "key": "requirements",
          "heading": "2. Requirements",
          "required_fields": [
            "normative_statements",
            "rationale"
          ]
        },
        {
          "key": "acceptance",
          "heading": "3. Acceptance conditions",
          "required_fields": [
            "measurable_conditions",
            "verification_method"
          ]
        },
        {
          "key": "trace",
          "heading": "4. Model and design trace",
          "required_fields": [
            "model_elements",
            "design_links"
          ]
        },
        {
          "key": "limits",
          "heading": "5. Status and limits",
          "required_fields": [
            "unresolved_items"
          ]
        }
      ],
      "default_template_id": "generic-requirements"
    },
