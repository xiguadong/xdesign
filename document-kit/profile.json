{
  "schema_version": "1.3",
  "profile_id": "xdesign-sysml-docs",
  "version": "1.3.0",
  "rules_file": "RULES.md",
  "skill_file": "SKILL.md",
  "rule_ids": [
    "DOC-001",
    "DOC-002",
    "DOC-003",
    "DOC-004",
    "DOC-005",
    "DOC-006",
    "DOC-007",
    "DOC-008",
    "DOC-009",
    "DOC-010"
  ],
  "project": {
    "docs_root": "docs",
    "model_roots": [
      "mbse/model"
    ],
    "optional_model_roots": [
      "mbse/wishes"
    ],
    "paths_are_project_relative": true
  },
  "document_classes": {
    "requirements": {
      "path_template": "docs/requirements/{name}.md",
      "filename_pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "default_template_id": "generic-requirements"
    },
    "architecture": {
      "path_template": "docs/architecture/{name}.md",
      "filename_pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "default_template_id": "generic-architecture"
    },
    "design": {
      "path_template": "docs/design/{name}.md",
      "filename_pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "default_template_id": "generic-design"
    },
    "interface": {
      "path_template": "docs/interfaces/{name}.md",
      "filename_pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "default_template_id": "generic-interface"
    },
    "verification": {
      "path_template": "docs/verification/{name}.md",
      "filename_pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "default_template_id": "generic-verification"
    },
    "api-design": {
      "path_template": "docs/design/api/{layer}/{name}.md",
      "filename_pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "default_template_id": "generic-api-design",
      "selector_kind": "api",
      "allowed_layers": [
        "core",
        "simple-flow",
        "wish-verify",
        "storage"
      ],
      "reserved_names": [
        "index"
      ]
    },
    "flow-index": {
      "path_template": "docs/design/flows/{name}/index.md",
      "filename_pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "default_template_id": "generic-flow-index",
      "selector_kind": "flow"
    },
    "flow-definition": {
      "path_template": "docs/design/flows/{name}/definition.md",
      "filename_pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "default_template_id": "generic-flow-definition",
      "selector_kind": "flow"
    },
    "flow-implementation": {
      "path_template": "docs/design/flows/{name}/implementation.md",
      "filename_pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "default_template_id": "generic-flow-implementation",
      "selector_kind": "flow"
    },
    "flow-views": {
      "path_template": "docs/design/flows/{name}/views.md",
      "filename_pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "default_template_id": "generic-flow-views",
      "selector_kind": "flow"
    }
  },
  "anchor_policy": {
    "format": "^[A-Z][0-9]+$",
    "globally_unique": true,
    "preserve_existing": true,
    "explicit_ids_required": true,
    "id_prefixes": [
      "A",
      "B",
      "D",
      "R",
      "F",
      "E",
      "I",
      "V",
      "U"
    ],
    "preferred_prefixes": {
      "requirements": [
        "R"
      ],
      "architecture": [
        "A",
        "B"
      ],
      "design": [
        "D"
      ],
      "interface": [
        "I"
      ],
      "verification": [
        "V"
      ],
      "api-design": [
        "U"
      ],
      "flow-index": [
        "D"
      ],
      "flow-definition": [
        "D"
      ],
      "flow-implementation": [
        "D"
      ],
      "flow-views": [
        "D"
      ]
    }
  },
  "figure_block": {
    "required": "when_model_figure_embedded",
    "field_tokens": {
      "Question": "question",
      "Model view": "model_view",
      "Companions": "companions",
      "Status": "status",
      "Reading": "reading",
      "Limits": "limits"
    },
    "statuses": [
      "renderable-now",
      "planned",
      "table-substitute",
      "external-tool"
    ],
    "software_claim_qualifiers": [
      "designed-only",
      "implemented"
    ],
    "label_format": "Figure <section-id>-<ordinal>",
    "asset_directory": "assets",
    "asset_extension": ".svg",
    "templates": {
      "en": "templates/figure-block.en.md",
      "zh-CN": "templates/figure-block.zh-CN.md"
    }
  },
  "validation": {
    "template_scope": "managed_documents_only",
    "managed_marker": "<!-- document-kit: profile={profile_id}@{version} class={document_class} template={template_id} language={language} contract={contract_sha256} digest-version={contract_digest_version} -->",
    "no_placeholder_acceptance": true,
    "placeholder_patterns": [
      "\\{\\{[^}]+\\}\\}",
      "\\bTODO\\b",
      "\\bTBD\\b",
      "\\bFIXME\\b"
    ],
    "semantic_review_required": true,
    "model_compiler_required_for_model_changes": true,
    "strict_docs_build_required": true
  },
  "catalog": {
    "manifest": "catalog/manifest.json",
    "sources": "catalog/shared/sources.json",
    "routing_guide": "catalog/shared/routing.md",
    "mixed_fixture": "catalog/shared/mixed/fixture.json",
    "entry_root": "catalog/entries"
  },
  "compatibility_packs": [
    {
      "profile_id": "xdesign-sysml-docs",
      "version": "1.0.0",
      "root": "compatibility/v1.0.0",
      "contract_sha256": "1fc588f652dec5e36504b9a2c9046539857094177cdfb790d88626174d2926a6",
      "contract_digest_version": "1"
    },
    {
      "profile_id": "xdesign-sysml-docs",
      "version": "1.1.0",
      "root": "compatibility/v1.1.0",
      "contract_sha256": "e2b827c6e929f4a8d03344a91ca72f2eb837962e916d5e7f0487e315e1440cef",
      "contract_digest_version": "2"
    },
    {
      "profile_id": "xdesign-sysml-docs",
      "version": "1.2.0",
      "root": "compatibility/v1.2.0",
      "contract_sha256": "a4ab976f05769bff34f3b6d3acd0de1dafb728dcf372d099fc3ac938758cf698",
      "contract_digest_version": "2"
    }
  ],
  "language_policy": {
    "supported_ids": [
      "en",
      "zh-CN"
    ],
    "default": "en"
  }
}
