  "anchor_policy": {
    "format": "^[A-Z][0-9]+$",
    "globally_unique": true,
    "preserve_existing": true,
    "explicit_ids_required": true,
    "id_prefixes": [
      "A",
      "B",
      "D",
      "R",
      "F",
      "E",
      "I",
      "V",
      "U"
    ],
    "preferred_prefixes": {
      "requirements": [
        "R"
      ],
      "architecture": [
        "A",
        "B"
      ],
      "design": [
        "D"
      ],
      "interface": [
        "I"
      ],
      "verification": [
        "V"
      ],
      "api-design": [
        "U"
      ],
      "flow-index": [
        "D"
      ],
      "flow-definition": [
        "D"
      ],
      "flow-implementation": [
        "D"
      ],
      "flow-views": [
        "D"
      ]
    }
  },
  "figure_block": {
    "required": "when_model_figure_embedded",
    "template": "templates/figure-block.md",
    "ordered_fields": [
      "Question",
      "Model view",
      "Companions",
      "Status",
      "Reading",
      "Limits"
    ],
    "field_tokens": {
      "Question": "question",
      "Model view": "model_view",
      "Companions": "companions",
      "Status": "status",
      "Reading": "reading",
      "Limits": "limits"
    },
    "statuses": [
      "renderable-now",
      "planned",
      "table-substitute",
      "external-tool"
    ],
    "software_claim_qualifiers": [
      "designed-only",
      "implemented"
    ],
    "label_format": "Figure <section-id>-<ordinal>",
    "asset_directory": "assets",
    "asset_extension": ".svg"
  },
  "validation": {
    "template_scope": "managed_documents_only",
    "managed_marker": "<!-- document-kit: profile={profile_id}@{version} class={document_class} template={template_id} contract={contract_sha256} digest-version={contract_digest_version} -->",
    "no_placeholder_acceptance": true,
    "placeholder_patterns": [
      "\\{\\{[^}]+\\}\\}",
      "\\bTODO\\b",
      "\\bTBD\\b",
      "\\bFIXME\\b"
    ],
    "semantic_review_required": true,
    "model_compiler_required_for_model_changes": true,
    "strict_docs_build_required": true
  },
  "catalog": {
    "manifest": "catalog/manifest.json",
    "sources": "catalog/sources.json",
    "routing_guide": "catalog/routing.md",
