  "overlays": {
    "busy_lease": "migration_busy for every operation, including diagnostics; no partial data",
    "invalid_coordination": "coordination_corrupt for all operations except doctor/inspect diagnostic after complete lease; preserve bytes",
    "alias": {"final_symlink": "unsafe_path","unsupported_mount": "identity_unprovable","changed_alias": "identity_unprovable","parent_symlink": "root alias equivalent after canonicalization; creation/output paths are separately tested and refuse any lexical ancestor symlink","case_normalization": "equivalent only when the filesystem resolves it to the identical pinned objects; otherwise identity_unprovable"},
    "held_construction": "A source handle can precede migration; destination held handle is unconstructible before committed/source_changed. For those destination cells record the base open refusal as construction result and call_executed=false. This does not skip required fresh construction tests.",
    "missing_root": {"source_absent": "status/request/abort follow their phase; apply in decision_uncertain first resolves the decision (same committed result if confirmed, exit 7 if unresolved, identity_unprovable only if conclusive absence); apply in other pre-decision phases refuses identity_unprovable (aborted replays migration_aborted). Ordinary source reads are not_found, source mutations retired after decision, busy while fenced, otherwise identity_unprovable; destination remains usable after confirmed decision.","destination_absent": "expected before target allocation in route_only/reserved; after committed/source_changed ordinary destination and migration apply/status/abort/discard refuse identity_unprovable; request remains recoverable; source remains retired; before decision source remains fenced and exact apply may reconstruct only its proven attempt under D119, never ordinary init"},
    "default_selection": "Default never selects source. Source cells are candidate inspection only, call_executed=false for ordinary APIs. Destination ordinary calls before decision return migration_required (or migration_busy during fenced/preparing/prepared/uncertain), after aborted migration_required, after source_changed source_changed. Doctor/inspect stay diagnostic; status/request/apply/abort/discard are explicit-root/request operations and ignore default selection.",
    "surface_mask": "Keep only the fields listed in surface_masks[operation.surface]; set all other exit/status fields to null on success and refusal. Checked-blocked lifecycle write may exit 1 instead of 0 according to the flow result; an I22 location refusal remains exit 2.",
    "decision_resolution": "For decision_uncertain status/apply/abort/discard resolve the possible decision before source-presence checks: confirmed re-evaluates committed, unresolved returns migration_outcome_unknown, absent re-evaluates prepared. Request recovery uses the durable reservation independently."
  },
  "additional_cases": [
    {"condition": "changed bytes same migration ID","operation": "apply","symbol": "operation_mismatch"},
    {"condition": "foreign epoch/key/route or unexpected partial record in an ID slot (not an unpublished draft)","operation": "status/request/apply/abort","symbol": "coordination_corrupt"},
    {"condition": "atomic final reservation publication/presence/durability cannot be resolved","operation": "status/request/apply/abort/discard/new-ID","symbol": "migration_outcome_unknown"},
    {"condition": "genuine legacy only; no known persistent candidate; missing/unsafe unrelated home or no binding","operation": "legacy read/next/check/completed","symbol": "read","effect": "legacy behavior only; no persistent open/enrollment; legacy mutation follows original lifecycle"},
    {"condition": "same ID reachable selected local/global candidate and legacy","operation": "unqualified read/work/all mutation","symbol": "backend_conflict"},
    {"condition": "known persistent candidate unreadable","operation": "unqualified legacy continuation","symbol": "backend_ambiguous"},
    {"condition": "retained source moved with attribute","operation": "source mutation","symbol": "source_moved"},
    {"condition": "retained source recreated after decision","operation": "any destination mutation or fresh source mutation","symbol": "source_changed"},
    {"condition": "held root/database replaced","operation": "ordinary held call","symbol": "identity_unprovable"},
    {"condition": "decision exists and abort exists same attempt","operation": "status/apply/abort","symbol": "coordination_corrupt"},
    {"condition": "no final reservation, only unpublished draft and/or safe empty slot; absence conclusively confirmed","operation": "status/request/abort/discard","symbol": "not_found","effect": "no effects; exact bytes/nonce unavailable; drafts preserved after proof loss"},
    {"condition": "unpublished draft, no accepted final, fresh explicit full request, source present and eligible destination","operation": "same-ID or new-ID apply","symbol": "cutover","effect": "new attempt after all preconditions; no draft adopted; no old accepted nonce exists"},
    {"condition": "unpublished draft, no accepted final, fresh explicit full request, source absent","operation": "same-ID or new-ID apply","symbol": "identity_unprovable"},
    {"condition": "durable reservation, partial/missing derivative request and lost original/cache","operation": "request","symbol": "request_bytes","effect": "exact accepted bytes and nonce remain in final reservation"}
  ],
