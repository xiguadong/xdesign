    {"name": "no-source-apply-before-decision","when": {"root_presence": ["source_absent"],"phase": ["route_only","reserved","fenced","preparing","prepared","aborted"],"operation": ["apply"]},"result": "identity_unprovable","call_executed": true},
    {"name": "no-source-retired-write","when": {"root_presence": ["source_absent"],"phase": ["committed"],"root": ["source"],"operation": ["init","write","terminal_retry","work_restore"]},"result": "source_retired","call_executed": true},
    {"name": "no-source-fenced","when": {"root_presence": ["source_absent"],"phase": ["fenced","preparing","prepared","decision_uncertain"],"root": ["source"],"operation": ["open","init","write","terminal_retry","query","bytes","work_restore","completed_read","info"]},"result": "migration_busy","call_executed": true},
    {"name": "no-source-unfenced-write","when": {"root_presence": ["source_absent"],"phase": ["route_only","reserved","aborted"],"root": ["source"],"operation": ["init","write","terminal_retry","work_restore"]},"result": "identity_unprovable","call_executed": true},
    {"name": "no-source-read","when": {"root_presence": ["source_absent"],"root": ["source"],"operation": ["open","query","bytes","info","completed_read"]},"result": "not_found","call_executed": true},
    {"name": "no-destination-terminal-protocol","when": {"root_presence": ["destination_absent"],"phase": ["committed","source_changed"],"operation": ["status","apply","abort","discard"]},"result": "identity_unprovable","call_executed": true},
    {"name": "no-destination-terminal-read","when": {"root_presence": ["destination_absent"],"phase": ["committed","source_changed"],"root": ["destination"],"operation": ["open","init","write","terminal_retry","query","bytes","work_restore","completed_read","info"]},"result": "identity_unprovable","call_executed": true},
    {"name": "default-before-cutover","when": {"selection": ["default"],"root": ["destination"],"phase": ["route_only","reserved","aborted"],"operation": ["open","init","write","terminal_retry","query","bytes","work_restore","completed_read","info"]},"result": "migration_required","call_executed": true},
    {"name": "default-fenced","when": {"selection": ["default"],"root": ["destination"],"phase": ["fenced","preparing","prepared","decision_uncertain"],"operation": ["open","init","write","terminal_retry","query","bytes","work_restore","completed_read","info"]},"result": "migration_busy","call_executed": true},
    {"name": "default-source-changed","when": {"selection": ["default"],"root": ["destination"],"phase": ["source_changed"],"operation": ["open","init","write","terminal_retry","query","bytes","work_restore","completed_read","info"]},"result": "source_changed","call_executed": true}
  ],
  "rule_semantics": {
    "match": "all listed dimensions contain the cell value; omitted dimensions are unconstrained; first matching rule wins",
    "base_open": "base rows[phase][root][open] as construction result, with call_executed=false",
    "committed_equivalent": "re-evaluate the same cell with phase=committed: a freshly proven absent source clears the changed-source observation, preserving the durable decision",
    "fallback": "rows[phase][root][operation]",
    "non_endpoint": "surface mask sets missing exit/status to null, never invent an HTTP migration endpoint",
    "resolve_decision": "Use resolution_inputs.decision_resolution (default unresolved): confirmed recursively resolves phase=committed; absent recursively resolves phase=prepared; unresolved yields migration_outcome_unknown. Retain all other cell values and apply surface masks only to the resolved result."
  },
  "surface_masks": {
    "store": ["store_exit"],
    "migration": ["store_exit"],
    "lifecycle": ["lifecycle_exit"],
    "store_web": ["store_exit","http"],
    "lifecycle_web": ["lifecycle_exit","http"],
    "web": ["http"],
    "all": ["store_exit","lifecycle_exit","http"]
  },
  "completed_web_cases": [
    {"method": "GET","path": "/api/wishes/{id}/work","access_operation": "completed_read","surface": "web","success": {"reason": null,"http": 200,"outcome": "completed_work","completed": true,"work": null},"effect": "next only; no check/save or history write"},
    {"method": "POST","path": "/api/wishes/{id}/check","access_operation": "completed_read","surface": "web","success": {"reason": "already_delivered","http": 409,"outcome": "refusal"},"effect": "next reports completed; no check/save is invoked"}
  ],
  "completed_web_semantics": "Apply the completed_read location/access result first, without its lifecycle surface mask. A refusal keeps its I22 HTTP mapping. On successful access select the explicit endpoint success object, then mask to web only. CLI completed check success does not imply POST check success.",
  "resolution_inputs": {
    "decision_resolution": ["unresolved","confirmed","absent"],
    "default": "unresolved",
    "meaning": "Used only for decision_uncertain status/apply/abort/discard after complete leases and record validation: confirmed means exact decision plus durability confirmed; absent means conclusive absence plus successful directory synchronization; every indeterminate read/publication/sync is unresolved. No value can be chosen merely from source absence."
  }
}
